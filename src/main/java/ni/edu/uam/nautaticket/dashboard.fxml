<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.nautaticket.controller.DashboardController" spacing="18" prefWidth="700" prefHeight="350">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
    <Label text="Estadísticas de tickets" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label text="Filtrar por fecha de creación y estado actual"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Desde"/><DatePicker fx:id="fechaDesde"/>
        <Label text="Hasta"/><DatePicker fx:id="fechaHasta"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Estado"/><ComboBox fx:id="filtroEstado" prefWidth="160"/>
        <Button text="Aplicar" onAction="#actualizar"/>
        <Button text="Limpiar" onAction="#limpiar"/>
    </HBox>
    <HBox spacing="30">
        <VBox spacing="8"><Label text="Pendientes"/><Label fx:id="pendientes" text="—" style="-fx-font-size: 26px;"/></VBox>
        <VBox spacing="8"><Label text="En proceso"/><Label fx:id="enProceso" text="—" style="-fx-font-size: 26px;"/></VBox>
        <VBox spacing="8"><Label text="Resueltos"/><Label fx:id="resueltos" text="—" style="-fx-font-size: 26px;"/></VBox>
    </HBox>
</VBox>
