<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.nautaticket.controller.AtencionController"
      spacing="12"
      prefWidth="900"
      prefHeight="650">

    <padding>
        <Insets top="18" right="18"
                bottom="18" left="18"/>
    </padding>

    <Label text="Atención de tickets - FIFO"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="ID técnico:"/>

        <TextField fx:id="campoTecnico"
                   promptText="ID del técnico"
                   prefWidth="110"
                   editable="false"/>

        <Button fx:id="botonActualizar"
                text="Actualizar listas"
                onAction="#actualizar"/>

        <Button fx:id="botonTomar"
                text="Tomar siguiente ticket FIFO"
                onAction="#tomarSiguiente"/>

        <ProgressIndicator fx:id="progresoToma"
                           accessibleText="Operación en curso"
                           prefWidth="22"
                           prefHeight="22"
                           maxWidth="22"
                           maxHeight="22"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="etiquetaCapacidad"
               text="Mis tickets activos: -- / 3"
               style="-fx-font-size: 14px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #285578;"/>

        <Label text="Máximo: 3 tickets simultáneos"
               style="-fx-text-fill: #666666;"/>
    </HBox>

    <Label text="Tickets pendientes"
           style="-fx-font-weight: bold;"/>

    <TableView fx:id="tablaPendientes"
               prefHeight="180"
               VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="columnaPendienteId"
                         text="ID"
                         prefWidth="65"/>

            <TableColumn fx:id="columnaPendienteTitulo"
                         text="Título"
                         prefWidth="550"/>

            <TableColumn fx:id="columnaPendienteFecha"
                         text="Fecha de creación"
                         prefWidth="200"/>
        </columns>
    </TableView>

    <Label text="Mis tickets asignados"
           style="-fx-font-weight: bold;"/>

    <TableView fx:id="tablaMisTickets"
               prefHeight="180"
               VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="columnaMioId"
                         text="ID"
                         prefWidth="65"/>

            <TableColumn fx:id="columnaMioTitulo"
                         text="Título"
                         prefWidth="550"/>

            <TableColumn fx:id="columnaMioEstado"
                         text="Estado"
                         prefWidth="200"/>
        </columns>
    </TableView>

    <Label text="Solución del ticket"/>

    <TextArea fx:id="campoSolucion"
              promptText="Describe la solución aplicada"
              prefRowCount="2"/>

    <HBox spacing="10">
        <Button fx:id="botonIniciar"
                text="Iniciar atención"
                onAction="#iniciar"/>

        <Button fx:id="botonResolver"
                text="Resolver ticket"
                onAction="#resolver"/>
    </HBox>

    <Label fx:id="mensaje"
           text="Cargando información de atención..."
           wrapText="true"/>

</VBox>
