<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.nautaticket.controller.PanelController"
            prefWidth="1024" prefHeight="740">
    <top>
        <VBox spacing="10" style="-fx-background-color: -fx-control-inner-background;">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="sesion"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Cerrar sesión" onAction="#cerrarSesion"/>
            </HBox>
            <FlowPane hgap="8" vgap="8">
                <Button fx:id="botonAdministracion" text="Administración" onAction="#abrirAdministracion"/>
                <Button text="Tickets" onAction="#abrirTickets"/>
                <Button fx:id="botonAtencion" text="Atención FIFO" onAction="#abrirAtencion"/>
                <Button text="Historial" onAction="#abrirHistorial"/>
                <Button fx:id="botonDashboard" text="Estadísticas" onAction="#abrirDashboard"/>
            </FlowPane>
            <Label fx:id="mensaje" wrapText="true" style="-fx-text-fill: #a12620;"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="contenido" fitToWidth="true" fitToHeight="true"/>
    </center>
</BorderPane>
