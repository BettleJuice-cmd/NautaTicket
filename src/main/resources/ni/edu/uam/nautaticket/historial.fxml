<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.nautaticket.controller.HistorialController" spacing="14">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="Historial de tickets" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <FlowPane hgap="8" vgap="8">
        <Label text="ID del ticket"/>
        <TextField fx:id="ticket" accessibleText="ID del ticket" prefWidth="85" onAction="#buscar"/>
        <Label text="Desde"/>
        <DatePicker fx:id="desde" accessibleText="Fecha del movimiento desde" prefWidth="145"/>
        <Label text="Hasta"/>
        <DatePicker fx:id="hasta" accessibleText="Fecha del movimiento hasta" prefWidth="145"/>
        <Label text="Estado nuevo"/>
        <ComboBox fx:id="estado" accessibleText="Estado nuevo" prefWidth="135"/>
    </FlowPane>
    <HBox spacing="8">
        <Button text="Buscar" onAction="#buscar"/>
        <Button text="Limpiar" onAction="#limpiar"/>
        <Label fx:id="mensaje" wrapText="true"/>
    </HBox>
    <TableView fx:id="movimientos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="140"/>
            <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="165"/>
            <TableColumn fx:id="colAnterior" text="Estado anterior" prefWidth="125"/>
            <TableColumn fx:id="colNuevo" text="Estado nuevo" prefWidth="125"/>
            <TableColumn fx:id="colComentario" text="Comentario" prefWidth="365"/>
        </columns>
    </TableView>
</VBox>
