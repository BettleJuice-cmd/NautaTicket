<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        name="reporte_tickets"
        language="java"
        pageWidth="842"
        pageHeight="595"
        orientation="Landscape"
        columnWidth="792"
        leftMargin="25"
        rightMargin="25"
        topMargin="25"
        bottomMargin="25"
        whenNoDataType="NoDataSection">

    <style name="NautaBase" default="true" fontName="Segoe UI" fontSize="9" forecolor="#243247"/>

    <parameter name="FECHA_DESDE" class="java.time.LocalDate"/>
    <parameter name="FECHA_HASTA" class="java.time.LocalDate"/>
    <parameter name="ESTADO_FILTRO" class="java.lang.String"/>
    <parameter name="FECHA_GENERACION" class="java.time.LocalDateTime"/>
    <parameter name="TOTAL_TICKETS" class="java.lang.Integer"/>
    <parameter name="TOTALES_ESTADO" class="java.util.Map"/>
    <parameter name="SIN_RESULTADOS" class="java.lang.Boolean"/>
    <parameter name="TITULO_REPORTE" class="java.lang.String"/>

    <field name="idTicket" class="java.lang.Integer"/>
    <field name="departamento" class="java.lang.String"/>
    <field name="titulo" class="java.lang.String"/>
    <field name="categoria" class="java.lang.String"/>
    <field name="tecnicoAsignado" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>
    <field name="fechaCreacion" class="java.time.LocalDateTime"/>
    <field name="fechaResolucion" class="java.time.LocalDateTime"/>

    <title height="112">

        <element kind="rectangle"
                 x="0" y="0" width="792" height="62"
                 backcolor="#152A3D" mode="Opaque">
            <pen lineWidth="0"/>
        </element>

        <element kind="rectangle"
                 x="0" y="0" width="6" height="62"
                 backcolor="#18A6A0" mode="Opaque">
            <pen lineWidth="0"/>
        </element>

        <element kind="staticText"
                 x="20" y="8" width="750" height="15"
                 fontSize="9" bold="true"
                 forecolor="#77D5D0">
            <text><![CDATA[NAUTATICKET]]></text>
        </element>

        <element kind="textField"
                 x="20" y="26" width="750" height="28"
                 fontSize="20" bold="true" forecolor="#FFFFFF">
            <expression><![CDATA[$P{TITULO_REPORTE}]]></expression>
        </element>

        <element kind="rectangle"
                 x="0" y="70" width="792" height="37"
                 backcolor="#F1F5F8" mode="Opaque">
            <pen lineWidth="0"/>
        </element>

        <element kind="textField"
                 x="14" y="75" width="550" height="16"
                 fontSize="9" bold="true" forecolor="#243247">
            <expression><![CDATA[
                "Período: " +
                ($P{FECHA_DESDE} == null ? "Inicio" : $P{FECHA_DESDE}.toString()) +
                " al " +
                ($P{FECHA_HASTA} == null ? "Actualidad" : $P{FECHA_HASTA}.toString()) +
                "     Estado: " + $P{ESTADO_FILTRO}
            ]]></expression>
        </element>

        <element kind="textField"
                 x="14" y="92" width="760" height="13"
                 fontSize="8" forecolor="#607083">
            <expression><![CDATA[
                "Generado: " + $P{FECHA_GENERACION}.format(
                    java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"))
            ]]></expression>
        </element>

        <element kind="textField"
                 x="570" y="77" width="204" height="16"
                 fontSize="9" bold="true" hTextAlign="Right" forecolor="#0D7776">
            <expression><![CDATA["Tickets: " + $P{TOTAL_TICKETS}]]></expression>
        </element>

    </title>

    <columnHeader height="34">

        <element kind="rectangle"
                 x="0" y="0" width="792" height="32"
                 backcolor="#E8F0F4" mode="Opaque">
            <pen lineWidth="0"/>
        </element>

        <element kind="staticText" x="2" y="7" width="35" height="16" bold="true" fontSize="8">
            <text><![CDATA[ID]]></text>
        </element>

        <element kind="staticText" x="40" y="7" width="90" height="16" bold="true" fontSize="8">
            <text><![CDATA[Departamento]]></text>
        </element>

        <element kind="staticText" x="132" y="7" width="142" height="16" bold="true" fontSize="8">
            <text><![CDATA[Incidencia]]></text>
        </element>

        <element kind="staticText" x="276" y="7" width="90" height="16" bold="true" fontSize="8">
            <text><![CDATA[Categoría]]></text>
        </element>

        <element kind="staticText" x="368" y="7" width="120" height="16" bold="true" fontSize="8">
            <text><![CDATA[Técnico]]></text>
        </element>

        <element kind="staticText" x="490" y="7" width="75" height="16" bold="true" fontSize="8">
            <text><![CDATA[Estado]]></text>
        </element>

        <element kind="staticText" x="567" y="7" width="100" height="16" bold="true" fontSize="8">
            <text><![CDATA[Creación]]></text>
        </element>

        <element kind="staticText" x="669" y="7" width="120" height="16" bold="true" fontSize="8">
            <text><![CDATA[Resolución]]></text>
        </element>

    </columnHeader>

    <detail>
        <band height="34" splitType="Prevent">

            <element kind="textField"
                     x="2" y="6" width="35" height="22"
                     fontSize="8.5" bold="true" forecolor="#0D7776">
                <expression><![CDATA[$F{idTicket}]]></expression>
            </element>

            <element kind="textField"
                     x="40" y="6" width="90" height="22"
                     fontSize="8.5" textAdjust="StretchHeight">
                <expression><![CDATA[$F{departamento}]]></expression>
            </element>

            <element kind="textField"
                     x="132" y="6" width="142" height="22"
                     fontSize="8.5" bold="true" textAdjust="StretchHeight">
                <expression><![CDATA[$F{titulo}]]></expression>
            </element>

            <element kind="textField"
                     x="276" y="6" width="90" height="22"
                     fontSize="8.5" textAdjust="StretchHeight">
                <expression><![CDATA[$F{categoria}]]></expression>
            </element>

            <element kind="textField"
                     x="368" y="6" width="120" height="22"
                     fontSize="8.5" textAdjust="StretchHeight">
                <expression><![CDATA[$F{tecnicoAsignado}]]></expression>
            </element>

            <element kind="textField"
                     x="490" y="6" width="75" height="22"
                     fontSize="8.5">
                <expression><![CDATA[$F{estado}]]></expression>
            </element>

            <element kind="textField"
                     x="567" y="6" width="100" height="22"
                     fontSize="8.5">
                <expression><![CDATA[
                    $F{fechaCreacion} == null
                    ? "-"
                    : $F{fechaCreacion}.format(
                        java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm")
                    )
                ]]></expression>
            </element>

            <element kind="textField"
                     x="669" y="6" width="120" height="22"
                     fontSize="8.5">
                <expression><![CDATA[
                    $F{fechaResolucion} == null
                    ? "Sin resolver"
                    : $F{fechaResolucion}.format(
                        java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm")
                    )
                ]]></expression>
            </element>

            <element kind="line" positionType="FixRelativeToBottom"
                     x="0" y="33" width="792" height="1">
                <pen lineWidth="0.4" lineColor="#E3E9EE"/>
            </element>

        </band>
    </detail>

    <summary height="125">

        <element kind="rectangle"
                 x="0" y="5" width="792" height="115"
                 backcolor="#F1F5F8" mode="Opaque">
            <pen lineWidth="0"/>
        </element>

        <element kind="staticText"
                 x="16" y="15" width="350" height="22"
                 fontSize="14" bold="true"
                 forecolor="#152A3D">
            <text><![CDATA[Resumen del período]]></text>
        </element>

        <element kind="textField"
                 x="16" y="39" width="300" height="20"
                 fontSize="12" bold="true" forecolor="#0D7776">
            <expression><![CDATA[
                "Total de tickets: " + $P{TOTAL_TICKETS}
            ]]></expression>
        </element>

        <element kind="rectangle" x="15" y="71" width="180" height="30" backcolor="#FFF4DD" mode="Opaque"><pen lineWidth="0"/></element>
        <element kind="rectangle" x="205" y="71" width="180" height="30" backcolor="#E5F1FC" mode="Opaque"><pen lineWidth="0"/></element>
        <element kind="rectangle" x="395" y="71" width="180" height="30" backcolor="#E2F4EF" mode="Opaque"><pen lineWidth="0"/></element>
        <element kind="rectangle" x="585" y="71" width="180" height="30" backcolor="#EEE9F8" mode="Opaque"><pen lineWidth="0"/></element>

        <element kind="textField"
                 x="25" y="78" width="160" height="17"
                 fontSize="10" bold="true" forecolor="#805D16">
            <expression><![CDATA[
                "Pendientes: " +
                $P{TOTALES_ESTADO}.getOrDefault("PENDIENTE", 0L)
            ]]></expression>
        </element>

        <element kind="textField"
                 x="215" y="78" width="160" height="17"
                 fontSize="10" bold="true" forecolor="#275887">
            <expression><![CDATA[
                "En proceso: " +
                $P{TOTALES_ESTADO}.getOrDefault("EN_PROCESO", 0L)
            ]]></expression>
        </element>

        <element kind="textField"
                 x="405" y="78" width="160" height="17"
                 fontSize="10" bold="true" forecolor="#126D59">
            <expression><![CDATA[
                "Resueltos: " +
                $P{TOTALES_ESTADO}.getOrDefault("RESUELTO", 0L)
            ]]></expression>
        </element>

        <element kind="textField"
                 x="595" y="78" width="160" height="17"
                 fontSize="10" bold="true" forecolor="#5D4A87">
            <expression><![CDATA[
                "Cerrados: " +
                $P{TOTALES_ESTADO}.getOrDefault("CERRADO", 0L)
            ]]></expression>
        </element>

    </summary>

    <pageFooter height="25">
        <element kind="textField"
                 x="0" y="5" width="792" height="15"
                 fontSize="8" hTextAlign="Center"
                 forecolor="#607083">
            <expression><![CDATA[
                "NautaTicket - Página " + $V{PAGE_NUMBER}
            ]]></expression>
        </element>
    </pageFooter>

    <noData height="135">

        <element kind="textField"
                 x="0" y="12" width="792" height="28"
                 fontSize="18" bold="true"
                 hTextAlign="Center"
                 forecolor="#152A3D">
            <expression><![CDATA[$P{TITULO_REPORTE}]]></expression>
        </element>

        <element kind="staticText"
                 x="0" y="48" width="792" height="28"
                 fontSize="13" hTextAlign="Center">
            <text><![CDATA[No se encontraron tickets para los filtros seleccionados.]]></text>
        </element>

        <element kind="textField"
                 x="0" y="83" width="792" height="20"
                 fontSize="10" hTextAlign="Center">
            <expression><![CDATA[
                "Estado: " + $P{ESTADO_FILTRO} +
                " | Total de tickets: 0"
            ]]></expression>
        </element>

        <element kind="textField"
                 x="0" y="108" width="792" height="18"
                 fontSize="9" hTextAlign="Center">
            <expression><![CDATA[
                "Período: " +
                ($P{FECHA_DESDE} == null ? "Inicio" : $P{FECHA_DESDE}.toString()) +
                " al " +
                ($P{FECHA_HASTA} == null ? "Actualidad" : $P{FECHA_HASTA}.toString())
            ]]></expression>
        </element>

    </noData>

</jasperReport>
