<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
        name="reporte_movimientos"
        language="java"
        pageWidth="595"
        pageHeight="842"
        orientation="Portrait"
        columnWidth="535"
        leftMargin="30"
        rightMargin="30"
        topMargin="30"
        bottomMargin="30"
        whenNoDataType="NoDataSection">

    <!-- PARAMETROS DEL REPORTE -->

    <parameter name="TOTAL_MOVIMIENTOS"
               class="java.lang.Integer"/>

    <parameter name="TOTAL_TICKETS"
               class="java.lang.Integer"/>

    <parameter name="CAMBIOS_ESTADO"
               class="java.lang.Integer"/>

    <parameter name="CAMBIOS_TECNICO"
               class="java.lang.Integer"/>

    <parameter name="FECHA_DESDE"
               class="java.lang.String"/>

    <parameter name="FECHA_HASTA"
               class="java.lang.String"/>

    <parameter name="ESTADO_FILTRO"
               class="java.lang.String"/>

    <parameter name="FECHA_GENERACION"
               class="java.lang.String"/>

    <!-- CAMPOS DE LA BITACORA -->

    <field name="idHistorial"
           class="java.lang.Integer"/>

    <field name="idTicket"
           class="java.lang.Integer"/>

    <field name="tituloTicket"
           class="java.lang.String"/>

    <field name="fecha"
           class="java.lang.String"/>

    <field name="responsable"
           class="java.lang.String"/>

    <field name="tipo"
           class="java.lang.String"/>

    <field name="estadoAnterior"
           class="java.lang.String"/>

    <field name="estadoNuevo"
           class="java.lang.String"/>

    <field name="comentario"
           class="java.lang.String"/>

    <!-- ENCABEZADO EDITORIAL -->

    <title height="185">

        <element kind="rectangle"
                 x="0" y="0"
                 width="5" height="56"
                 mode="Opaque"
                 backcolor="#785F98"/>

        <element kind="staticText"
                 x="18" y="1"
                 width="310" height="17"
                 fontSize="9"
                 bold="true"
                 forecolor="#785F98">
            <text><![CDATA[NAUTATICKET / SOPORTE TI]]></text>
        </element>

        <element kind="staticText"
                 x="18" y="20"
                 width="395" height="31"
                 fontSize="22"
                 bold="true"
                 forecolor="#292331">
            <text><![CDATA[Registro de actividad]]></text>
        </element>

        <element kind="staticText"
                 x="416" y="5"
                 width="119" height="16"
                 fontSize="9"
                 bold="true"
                 hTextAlign="Right"
                 forecolor="#785F98">
            <text><![CDATA[INFORME 02]]></text>
        </element>

        <element kind="staticText"
                 x="416" y="25"
                 width="119" height="16"
                 fontSize="8"
                 hTextAlign="Right"
                 forecolor="#746A7F">
            <text><![CDATA[AUDITORIA]]></text>
        </element>

        <element kind="line"
                 x="0" y="68"
                 width="535" height="1">
            <pen lineWidth="1"
                 lineColor="#392B47"/>
        </element>

        <element kind="staticText"
                 x="0" y="80"
                 width="535" height="18"
                 fontSize="10"
                 bold="true"
                 forecolor="#392B47">
            <text><![CDATA[Bitácora cronológica de movimientos]]></text>
        </element>

        <element kind="textField"
                 x="0" y="100"
                 width="535" height="16"
                 fontSize="9"
                 forecolor="#746A7F">
            <expression><![CDATA[
                "Periodo: " + $P{FECHA_DESDE}
                + " al " + $P{FECHA_HASTA}
            ]]></expression>
        </element>

        <element kind="textField"
                 x="0" y="121"
                 width="535" height="16"
                 fontSize="9"
                 forecolor="#746A7F">
            <expression><![CDATA[
                "Estado: " + $P{ESTADO_FILTRO}
                + "    /    Generado: "
                + $P{FECHA_GENERACION}
            ]]></expression>
        </element>

        <element kind="line"
                 x="0" y="145"
                 width="535" height="1">
            <pen lineWidth="0.5"
                 lineColor="#D8D1E0"/>
        </element>

        <element kind="staticText"
                 x="0" y="153"
                 width="120" height="12"
                 fontSize="8"
                 forecolor="#746A7F">
            <text><![CDATA[MOVIMIENTOS]]></text>
        </element>

        <element kind="textField"
                 x="0" y="167"
                 width="120" height="18"
                 fontSize="14"
                 bold="true"
                 forecolor="#392B47">
            <expression><![CDATA[
                $P{TOTAL_MOVIMIENTOS}
            ]]></expression>
        </element>

        <element kind="staticText"
                 x="135" y="153"
                 width="120" height="12"
                 fontSize="8"
                 forecolor="#746A7F">
            <text><![CDATA[TICKETS AFECTADOS]]></text>
        </element>

        <element kind="textField"
                 x="135" y="167"
                 width="120" height="18"
                 fontSize="14"
                 bold="true"
                 forecolor="#392B47">
            <expression><![CDATA[
                $P{TOTAL_TICKETS}
            ]]></expression>
        </element>

        <element kind="staticText"
                 x="270" y="153"
                 width="120" height="12"
                 fontSize="8"
                 forecolor="#746A7F">
            <text><![CDATA[CAMBIOS DE ESTADO]]></text>
        </element>

        <element kind="textField"
                 x="270" y="167"
                 width="120" height="18"
                 fontSize="14"
                 bold="true"
                 forecolor="#392B47">
            <expression><![CDATA[
                $P{CAMBIOS_ESTADO}
            ]]></expression>
        </element>

        <element kind="staticText"
                 x="405" y="153"
                 width="130" height="12"
                 fontSize="8"
                 forecolor="#746A7F">
            <text><![CDATA[CAMBIOS DE TECNICO]]></text>
        </element>

        <element kind="textField"
                 x="405" y="167"
                 width="130" height="18"
                 fontSize="14"
                 bold="true"
                 forecolor="#392B47">
            <expression><![CDATA[
                $P{CAMBIOS_TECNICO}
            ]]></expression>
        </element>

    </title>

    <!-- TITULO DE SECCION -->

    <columnHeader height="38">

        <element kind="line"
                 x="0" y="4"
                 width="535" height="1">
            <pen lineWidth="0.5"
                 lineColor="#D8D1E0"/>
        </element>

        <element kind="staticText"
                 x="0" y="15"
                 width="360" height="17"
                 fontSize="10"
                 bold="true"
                 forecolor="#392B47">
            <text><![CDATA[CRONOLOGIA DE EVENTOS]]></text>
        </element>

        <element kind="staticText"
                 x="385" y="16"
                 width="150" height="15"
                 fontSize="8"
                 hTextAlign="Right"
                 forecolor="#746A7F">
            <text><![CDATA[ORDEN TEMPORAL]]></text>
        </element>

    </columnHeader>

    <!-- UNA FICHA POR MOVIMIENTO -->

    <detail>

        <band height="181" splitType="Prevent">

            <!-- EJE VERTICAL -->

            <element kind="rectangle"
                     x="76" y="0"
                     width="2" height="179"
                     mode="Opaque"
                     backcolor="#D8CEE2"/>

            <element kind="ellipse"
                     x="69" y="13"
                     width="16" height="16"
                     mode="Opaque"
                     backcolor="#785F98"/>

            <!-- FECHA DEL EVENTO -->

            <element kind="textField"
                     x="0" y="7"
                     width="64" height="48"
                     fontSize="8"
                     bold="true"
                     hTextAlign="Right"
                     forecolor="#554A60">
                <expression><![CDATA[
                    $F{fecha}
                ]]></expression>
            </element>

            <!-- FONDO DE LA FICHA -->

            <element kind="rectangle"
                     x="94" y="2"
                     width="441" height="173"
                     mode="Opaque"
                     backcolor="#F6F3F8"/>

            <element kind="rectangle"
                     x="94" y="2"
                     width="4" height="173"
                     mode="Opaque"
                     backcolor="#785F98"/>

            <!-- IDENTIFICACION -->

            <element kind="textField"
                     x="109" y="12"
                     width="160" height="18"
                     fontSize="11"
                     bold="true"
                     forecolor="#30243D">
                <expression><![CDATA[
                    "TICKET #" + $F{idTicket}
                ]]></expression>
            </element>

            <element kind="textField"
                     x="311" y="13"
                     width="208" height="16"
                     fontSize="8"
                     bold="true"
                     hTextAlign="Right"
                     forecolor="#785F98">
                <expression><![CDATA[
                    $F{tipo}
                ]]></expression>
            </element>

            <element kind="textField"
                     x="109" y="35"
                     width="410" height="28"
                     fontSize="9"
                     forecolor="#6A6073"
                     textAdjust="ScaleFont">
                <expression><![CDATA[
                    $F{tituloTicket}
                ]]></expression>
            </element>

            <!-- TRANSICION DE ESTADO -->

            <element kind="rectangle"
                     x="109" y="70"
                     width="411" height="35"
                     mode="Opaque"
                     backcolor="#E9E2F0"/>

            <element kind="textField"
                     x="118" y="80"
                     width="145" height="16"
                     fontSize="9"
                     forecolor="#63566E"
                     textAdjust="ScaleFont">
                <expression><![CDATA[
                    $F{estadoAnterior}
                ]]></expression>
            </element>

            <element kind="staticText"
                     x="268" y="79"
                     width="24" height="18"
                     fontSize="12"
                     bold="true"
                     hTextAlign="Center"
                     forecolor="#785F98">
                <text><![CDATA[→]]></text>
            </element>

            <element kind="textField"
                     x="300" y="80"
                     width="208" height="16"
                     fontSize="9"
                     bold="true"
                     forecolor="#483659"
                     textAdjust="ScaleFont">
                <expression><![CDATA[
                    $F{estadoNuevo}
                ]]></expression>
            </element>

            <!-- RESPONSABLE -->

            <element kind="staticText"
                     x="109" y="115"
                     width="88" height="14"
                     fontSize="8"
                     bold="true"
                     forecolor="#554A60">
                <text><![CDATA[RESPONSABLE]]></text>
            </element>

            <element kind="textField"
                     x="204" y="115"
                     width="315" height="18"
                     fontSize="8"
                     forecolor="#39313F"
                     textAdjust="ScaleFont">
                <expression><![CDATA[
                    $F{responsable}
                ]]></expression>
            </element>

            <!-- OBSERVACION -->

            <element kind="staticText"
                     x="109" y="140"
                     width="88" height="14"
                     fontSize="8"
                     bold="true"
                     forecolor="#554A60">
                <text><![CDATA[OBSERVACION]]></text>
            </element>

            <element kind="textField"
                     x="204" y="138"
                     width="315" height="31"
                     fontSize="8"
                     forecolor="#6D6375"
                     textAdjust="ScaleFont">
                <expression><![CDATA[
                    $F{comentario}
                ]]></expression>
            </element>

        </band>

    </detail>

    <!-- FINAL DEL DOCUMENTO -->

    <summary height="67">

        <element kind="line"
                 x="0" y="9"
                 width="535" height="1">
            <pen lineWidth="0.7"
                 lineColor="#D8D1E0"/>
        </element>

        <element kind="staticText"
                 x="0" y="23"
                 width="535" height="18"
                 fontSize="11"
                 bold="true"
                 forecolor="#392B47">
            <text><![CDATA[Fin del registro de actividad]]></text>
        </element>

        <element kind="staticText"
                 x="0" y="45"
                 width="535" height="16"
                 fontSize="8"
                 forecolor="#746A7F">
            <text><![CDATA[Documento generado a partir del historial de NautaTicket.]]></text>
        </element>

    </summary>

    <!-- PAGINACION -->

    <pageFooter height="30">

        <element kind="line"
                 x="0" y="1"
                 width="535" height="1">
            <pen lineWidth="0.5"
                 lineColor="#D8D1E0"/>
        </element>

        <element kind="staticText"
                 x="0" y="10"
                 width="370" height="15"
                 fontSize="8"
                 forecolor="#746A7F">
            <text><![CDATA[NAUTATICKET / AUDITORIA DE SOPORTE TI]]></text>
        </element>

        <element kind="textField"
                 x="410" y="10"
                 width="125" height="15"
                 fontSize="8"
                 hTextAlign="Right"
                 forecolor="#746A7F">
            <expression><![CDATA[
                "PAGINA " + $V{PAGE_NUMBER}
            ]]></expression>
        </element>

    </pageFooter>

    <!-- SIN MOVIMIENTOS -->

    <noData height="230">

        <element kind="rectangle"
                 x="0" y="0"
                 width="5" height="55"
                 mode="Opaque"
                 backcolor="#785F98"/>

        <element kind="staticText"
                 x="18" y="2"
                 width="430" height="16"
                 fontSize="9"
                 bold="true"
                 forecolor="#785F98">
            <text><![CDATA[NAUTATICKET / AUDITORIA]]></text>
        </element>

        <element kind="staticText"
                 x="18" y="23"
                 width="500" height="30"
                 fontSize="21"
                 bold="true"
                 forecolor="#292331">
            <text><![CDATA[Registro de actividad]]></text>
        </element>

        <element kind="line"
                 x="0" y="73"
                 width="535" height="1">
            <pen lineWidth="0.7"
                 lineColor="#D8D1E0"/>
        </element>

        <element kind="staticText"
                 x="0" y="103"
                 width="535" height="26"
                 fontSize="15"
                 bold="true"
                 hTextAlign="Center"
                 forecolor="#483659">
            <text><![CDATA[No se encontraron movimientos]]></text>
        </element>

        <element kind="staticText"
                 x="0" y="141"
                 width="535" height="20"
                 fontSize="9"
                 hTextAlign="Center"
                 forecolor="#746A7F">
            <text><![CDATA[No existen registros para los filtros seleccionados.]]></text>
        </element>

        <element kind="textField"
                 x="0" y="184"
                 width="535" height="18"
                 fontSize="9"
                 hTextAlign="Center"
                 forecolor="#746A7F">
            <expression><![CDATA[
                "Periodo: " + $P{FECHA_DESDE}
                + " al " + $P{FECHA_HASTA}
            ]]></expression>
        </element>

    </noData>

</jasperReport>
